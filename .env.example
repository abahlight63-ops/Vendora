# ══ .env.example — COPY THIS TO `.env` AND FILL IT IN ═══════════════
# WHAT: environment variables = secrets + settings OUTSIDE the code.
# WHY: keys in code leak via git; keys in .env stay on YOUR machine (.gitignore
# blocks .env!). The `dotenv` npm package loads them into process.env at boot.
# RULES: NEVER commit real keys. Restart the server after ANY change here
# (Node reads .env ONCE at startup!). Copy: `cp .env.example .env` (or copy
# manually on Windows), then fill each value. Empty value = feature off.
# ══════════════════════════════════════════════════════════════════════════
# Server
PORT=3000

# Session signing secret (change to a long random string in production)
SESSION_SECRET=change-me-to-something-random

# Postgres (Supabase connection string or local postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp_support

# Admin API key (protects /api/businesses and the /admin onboarding form's API calls)
ADMIN_API_KEY=choose-a-long-random-string
# Admin console password (YOUR private /admin page login — long random string,
# stored in a password manager, never shared, never committed!)
ADMIN_PASSWORD=choose-an-even-longer-random-password

# AI provider: "gemini" (default, free tier) or "claude" (paid, best quality).
# The app tries AI_PROVIDER first, then automatically falls back to any other
# provider with a key below — so add backups and one AI going down never
# stops your bot. After ANY key change: restart the server (Ctrl+C, npm run dev).
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
# Dropdown default = lite model (fastest + cheapest). Pinned per pick, so the
# dropdown always sticks. To use another lite name (e.g. gemini-3.5-flash-lite
# once Google ships it): GEMINI_LITE_MODEL=gemini-3.5-flash-lite (no code change).
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# Full-size Gemini for the "Gemini Flash (full)" dropdown entry.
GEMINI_FULL_MODEL=gemini-2.5-flash
# Generic WhatsApp-bot fallback chain (only used when there is no dropdown pick).
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-flash-latest
# --- FREE backup AIs (optional but recommended: pick at least one) ---
# RULE: one API key per provider, 2 models max per key (keeps every key under
# its rate limit so nothing shows "busy").
# Groq: free tier, very fast. ONE key, TWO models (8B speed + 70B quality).
# Get the key at https://console.groq.com → API Keys → Create (free, no card).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
GROQ_OSS_MODEL=openai/gpt-oss-20b
GROQ_KIMI_MODEL=moonshotai/kimi-k2-instruct
# Whisper voice transcription (Pro voice notes, both channels)
WHISPER_MODEL=whisper-large-v3
# Quota tuning (50/day free for everything; governor protects the shared key)
MODEL_DAILY_CAP=50
CUSTOMER_DAILY_CAP=30
GROQ_RPM=30
# Telegram: ONE webhook secret for all bots (set SAME value in every BotFather
# setWebhook call!) + optional shared @VendoraBot token + its username.
TELEGRAM_WEBHOOK_SECRET=choose-a-long-random-string
TELEGRAM_SHARED_BOT_TOKEN=
TELEGRAM_SHARED_BOT_NAME=
# TokenRouter: ONE free key, TWO models. Get a free key on your TokenRouter
# dashboard → API Keys → Create, then paste it below as TOKENROUTER_API_KEY.
# Real model IDs (verified): deepseek-v4-flash (fast + cheapest), kimi-k2p6
# (smart), deepseek-v4-pro, kimi-k2p5, qwen3p7-plus, qwen3p6-plus, glm-5p1,
# gpt-oss-120b, minimax-m3, minimax-m2p7. List YOURS with
# GET https://tokenrouter.me/v1/models (key as Bearer token) and paste TWO
# names below. Different host? Set TOKENROUTER_BASE_URL to it (the app appends
# /chat/completions itself).
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://tokenrouter.me/v1
TOKENROUTER_MODEL=deepseek-v4-flash
TOKENROUTER_MODEL_2=kimi-k2p6
# SambaNova: ONE free key, TWO models. Get a key at https://cloud.sambanova.ai
# → API Keys (free, no card), then paste it below as SAMBANOVA_API_KEY.
# Current upstream IDs: Meta-Llama-3.3-70B-Instruct + gpt-oss-120b
# (the old 8B was retired upstream — don't set it, it will 404).
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_2=gpt-oss-120b
# Pollinations.ai: NO KEY NEEDED (emergency net, always on). Slower + weaker,
# tried LAST after every keyed provider fails. Override model rarely needed.
POLLINATIONS_MODEL=openai
# --- PAID AIs (Pro-only in the dropdown; you pay per reply) ---
# Anthropic: ONE key, TWO cheap models. Get a key at https://console.anthropic.com → API keys.
# (ANTHROPIC_API_KEY is already above next to GEMINI_API_KEY.)
# Override the 2nd cheap Haiku only if Anthropic renames it:
CLAUDE_MODEL_2=claude-3-haiku-20240307
# OpenAI: ONE key, TWO cheap models. Get a key at https://platform.openai.com → API keys. gpt-4o-mini is cheapest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_2=gpt-4.1-mini
# Daily caps (Vendora AI page): 50/day free for everything; Pro 50 premium/day
FREE_AI_PER_DAY=50
PAID_AI_PER_DAY=50
# WhatsApp bot replies per shop per day (Free 50 / Pro 500 / Pro Plus unlimited).
WHATSAPP_FREE_LIMIT=50
WHATSAPP_PRO_LIMIT=500
# Pro Plus is uncapped by design — no WHATSAPP_PLUS_LIMIT (Plus skips the cap check).
# --- Ads: PER-VIEW (network) + PER-CLICK (direct sponsor). Free tier only; Pro never sees ads. ---
# 1) PER-VIEW network (recommended: Monetag). Sign up at monetag.com → Sites →
#    MultiTag zone → copy the tag URL (the https://... .js address) below.
#    Views pay ~$0.50–2 per 1,000 (NG traffic). Earnings + payout in their dashboard.
ADS_PROVIDER=monetag
ADS_SCRIPT_URL=
# Second network (e.g. Adsterra SOCIAL BAR only — never a second popunder).
ADS_PROVIDER_2=adsterra
ADS_SCRIPT_URL_2=
# Third slot: POPUNDER (e.g. Adsterra popunder). Aggressive format — the app
# auto-caps it to once per browser per day so it never overshows. Paste ONLY
# the tag URL (the https://... .js address), never commit real URLs.
ADS_POPUNDER_PROVIDER=adsterra-popunder
ADS_POPUNDER_URL=
# 2) PER-CLICK direct sponsor (best rates: charge local businesses per click).
#    When set, free users see a labeled "Sponsored" card max once/day after key
#    actions. Every "Visit sponsor" tap is logged; bill the sponsor per click.
SPONSOR_TITLE=
SPONSOR_TEXT=
SPONSOR_LINK=
SPONSOR_IMAGE=
# VIDEO ADS (your own 15–30s mp4 — no ad network needed!): host the file
# free on Cloudinary (cloudinary.com → Media Library → Upload → copy URL),
# paste the https://...mp4 below, restart. Plays inside the Sponsored card
# on web + a Watch button in the phone app. Empty = text-only card.
SPONSOR_VIDEO_URL=
SPONSOR_RATE_PER_CLICK=50
# Check your click totals: GET /api/admin/ads/stats (admin session in /admin console, Revenue tab note)

# Email (verification codes, resets, support replies) — pick ONE path:
# A) Gmail SMTP (recommended WITHOUT a domain: free, ~500/day). Steps:
#    1. Google Account → Security → 2-Step Verification ON → App passwords →
#       Generate (name it "Vendora") → copy the 16-char code.
#    2. Paste below as EMAIL_SMTP_PASS (spaces don't matter) + your address
#       as EMAIL_SMTP_USER. Done — codes deliver to REAL users today.
# B) Resend (needs a domain YOU own verified at resend.com → Domains).
#    Until then, onboarding@resend.dev only delivers to YOUR OWN inbox!
# SMTP wins when both are set (zero domains needed!). Neither set = dev
# auto-verify (anyone can register — NEVER production!).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# Optional display name (Gmail shows your address unless "Send As" is set):
# EMAIL_FROM=Vendora <you@gmail.com>
# Resend path (100 emails/day free at resend.com):
RESEND_API_KEY=
EMAIL_FROM=Vendora <onboarding@resend.dev>
# Support inbox shown in every email footer (replies land here). Defaults to SALES_EMAIL below.
SUPPORT_EMAIL=
# Inactivity nudge: quiet shops get one "we miss you" email per 30 days after this many silent days.
INACTIVITY_DAYS=14
# StaticForms feedback copy (staticforms.xyz → Forms → API key): Help-form
# messages are ALSO emailed to your inbox. Empty = tickets stay in-app only.
STATICFORMS_KEY=
# Media that survives redeploys (Cloudinary free tier): cloudinary.com → sign up →
# Settings → Upload → Upload presets → Add (Signing Mode: UNSIGNED) → copy name.
# Without these, photos save to local disk (fine locally, WIPED on every Render deploy!).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Phone-bar push (Web Push, no vendor, no Firebase): run `npm run push:vapid`
# once, paste the pair below. Every bell (quota, replies, broadcasts) ALSO
# fans out here. Unset = bell only (push silently off — nothing breaks!).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourshop.com
# Google login (FREE forever): Google Cloud Console → APIs & Services →
# Credentials → Create Credentials → OAuth client ID → Web application →
# Authorized JavaScript origins: your frontend URL (+Vercel URL in prod).
# Copy the Client ID here (public value — also paste into Vercel as VITE_GOOGLE_CLIENT_ID? NO:
# backend serves it via /api/auth/config automatically. Just this one line!).
GOOGLE_CLIENT_ID=
# Bot wall: login/signup/OTP/forgot sit behind rate limits (30 tries/15min/IP)
# + OTP 5-attempt burn — no widget, nothing to configure.

# Meta WhatsApp Cloud API (Embedded Signup — the ONLY WhatsApp road).
# Create at developers.facebook.com → Create App (Business type) → Add Product:
# WhatsApp. Then copy:
#  META_APP_ID = App Dashboard → App ID (public — also served to the Connect page!).
#  META_CONFIGURATION_ID = WhatsApp → Embedded Signup configuration ID
#    (create one in the app dashboard; the popup will not open without it).
#  META_APP_SECRET = App Dashboard → App secret (SERVER ONLY — never paste in
#    browsers! Used to exchange the signup code for an access token. If empty,
#    the popup still works when Meta returns credentials directly, otherwise
#    owners use the manual paste fallback on the Connect page).
META_APP_ID=
META_CONFIGURATION_ID=
META_APP_SECRET=

# Paystack billing (Nigeria + international cards)
# CARD CHECKOUT NEEDS THIS KEY (the #1 "why is there no card button?" answer):
#  1. Sign up at https://paystack.com → Settings → API Keys
#  2. Copy the SECRET key (sk_test_... to test, sk_live_... for real money)
#  3. Paste below as PAYSTACK_SECRET_KEY and restart the server.
# Test keys work without BVN. Live keys need BVN + NIN + CAC.
# Until this is set, card checkout returns "not available" (app still works free).
PAYSTACK_SECRET_KEY=sk_test_xxxxx
# Pay-once / enterprise sales inbox (Billing "Contact sales" card mailtos here).
SALES_EMAIL=vendorabot26@gmail.com
PRICE_NAIRA=7499                # legacy monthly price (kept as fallback → Pro monthly)
# PRO tier (NGN): 7,499/mo, 69,999/yr (saves ₦19,989 ≈ 22% vs monthly).
PRICE_MONTHLY_NAIRA=7499        # Pro monthly (NGN)
PRICE_YEARLY_NAIRA=69999        # Pro yearly (NGN)
# PRO PLUS tier (NGN): 14,999/mo, 119,999/yr (saves ₦59,989 ≈ 33% vs monthly).
# Plus adds voice-note transcription (Whisper AI) + 2 heavy work models.
PRICE_PLUS_MONTHLY_NAIRA=14999  # Pro Plus monthly (NGN)
PRICE_PLUS_YEARLY_NAIRA=119999  # Pro Plus yearly (NGN)
# USD mirror for non-Nigerian businesses (yearly picked to mirror the NGN
# discount %: Pro 22%, Plus 33%). Paystack dashboard must have USD charges
# enabled or USD checkouts will fail.
PRICE_MONTHLY_USD=5             # Pro monthly (USD)
PRICE_YEARLY_USD=47             # Pro yearly (USD)
PRICE_PLUS_MONTHLY_USD=10       # Pro Plus monthly (USD)
PRICE_PLUS_YEARLY_USD=80        # Pro Plus yearly (USD)
# NOTE: lifetime self-serve is retired — pay-once buyers contact SALES_EMAIL
# above. Old PRICE_LIFETIME_* env vars are ignored (grandfathered buyers keep it).
# 7-day Pro trial (countdown shown in-app; expiry flips to free + bell notice).
# Trial needs NO cron and NO extra API keys — checked on every /api/me call.
TRIAL_DAYS=7
SUBSCRIPTION_DAYS=30
# Flutterwave (USD / international cards): Dashboard → Settings → API keys →
# copy the SECRET key (FLWSECK_TEST… to test, FLWSECK… live for real money),
# then Settings → Webhooks → copy the secret hash below.
FLW_SECRET_KEY=FLWSECK_TEST_xxxxx
FLW_SECRET_HASH=choose-a-long-random-string
# Bank transfer is RETIRED (card only: Paystack NGN + Flutterwave USD).
# The Admin → Transfers queue still drains old pending claims; new reports
# get a "retired" message. Leave these unset on fresh installs.
# Public base URL used for Paystack callback (set on Railway/Render, e.g. https://yourapp.up.railway.app)
# ALSO used for Upload-media product photos: the hosted image URL is built
# from this (Meta/Telegram fetch it to attach photos to bot replies).
# Leave empty in local dev (the server builds it from the request host).
PUBLIC_BASE_URL=
# ── Split deploy (Vercel frontend + Render backend) ──
# FRONTEND_URL: exact Vercel URL, set on RENDER (enables CORS + cross-site cookies).
# VITE_API_URL: exact Render URL, set in VERCEL dashboard (Vite bakes it at build!).
# Local dev: leave BOTH empty (same-origin mode, zero config).
FRONTEND_URL=
# VITE_API_URL is frontend-only: set it in Vercel, NOT in .env (Vite reads .env
# files too, but committing is avoided by keeping it dashboard-side).

# Daily digest
OWNER_WHATSAPP=whatsapp:+2348000000000
DIGEST_HOUR_UTC=17
