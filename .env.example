# ══ .env.example — COPY THIS TO `.env` AND FILL IT IN ═══════════════
# WHAT: environment variables = secrets + settings OUTSIDE the code.
# WHY: keys in code leak via git; keys in .env stay on YOUR machine (.gitignore
# blocks .env!). The `dotenv` npm package loads them into process.env at boot.
# RULES: NEVER commit real keys. Restart the server after ANY change here
# (Node reads .env ONCE at startup!). Copy: `cp .env.example .env` (or copy
# manually on Windows), then fill each value. Empty value = feature off.
# ══════════════════════════════════════════════════════════════════════════
# Server
PORT=3000

# Session signing secret (change to a long random string in production)
SESSION_SECRET=change-me-to-something-random

# Postgres (Supabase connection string or local postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp_support

# Admin API key (protects /api/businesses and the /admin onboarding form's API calls)
ADMIN_API_KEY=choose-a-long-random-string
# Admin console password (YOUR private /admin page login — long random string,
# stored in a password manager, never shared, never committed!)
ADMIN_PASSWORD=choose-an-even-longer-random-password

# AI provider: "gemini" (default, free tier) or "claude" (paid, best quality).
# The app tries AI_PROVIDER first, then automatically falls back to any other
# provider with a key below — so add backups and one AI going down never
# stops your bot. After ANY key change: restart the server (Ctrl+C, npm run dev).
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
# Verified working 2026-09-10: 2.5-flash first, lite as fallback. (3-flash doesn't exist, 2.0 retired.)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-lite-latest
# --- FREE backup AIs (optional but recommended: pick at least one) ---
# Groq: free tier, very fast. Get a key at https://console.groq.com → API Keys → Create.
# Free models you can use: llama-3.3-70b-versatile, llama-3.1-8b-instant (fastest),
# deepseek-r1-distill-llama-70b, meta-llama/llama-4-scout-17b-16e-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_DEEPSEEK_MODEL=deepseek-r1-distill-llama-70b
# OpenRouter: many free models. Get a key at https://openrouter.ai → Keys.
# Check free model names at https://openrouter.ai/models (look for ":free").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# --- PAID AIs (Pro-only in the dropdown; you pay per reply) ---
# OpenAI: get a key at https://platform.openai.com → API keys. gpt-4o-mini is cheapest.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Daily caps (Vendora AI page): free tier chats/day, Pro premium-AI chats/day
FREE_AI_PER_DAY=20
PAID_AI_PER_DAY=50
# --- Ads: PER-VIEW (network) + PER-CLICK (direct sponsor). Free tier only; Pro never sees ads. ---
# 1) PER-VIEW network (recommended: Monetag). Sign up at monetag.com → Sites →
#    MultiTag zone → copy the tag URL (the https://... .js address) below.
#    Views pay ~$0.50–2 per 1,000 (NG traffic). Earnings + payout in their dashboard.
ADS_PROVIDER=monetag
ADS_SCRIPT_URL=
# Second network (e.g. Adsterra SOCIAL BAR only — never a second popunder).
ADS_PROVIDER_2=adsterra
ADS_SCRIPT_URL_2=
# 2) PER-CLICK direct sponsor (best rates: charge local businesses per click).
#    When set, free users see a labeled "Sponsored" card max once/day after key
#    actions. Every "Visit sponsor" tap is logged; bill the sponsor per click.
SPONSOR_TITLE=
SPONSOR_TEXT=
SPONSOR_LINK=
SPONSOR_IMAGE=
SPONSOR_RATE_PER_CLICK=50
# Check your click totals: GET /api/ads/stats with header x-admin-key: <ADMIN_API_KEY>

# Resend email verification (free tier: 100 emails/day at resend.com)
RESEND_API_KEY=
EMAIL_FROM=Vendora <onboarding@resend.dev>

# Twilio (used for sending replies)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Paystack billing (Nigeria + international cards)
# NOTE: Paystack test keys work without BVN. Live keys need BVN + NIN + CAC.
# Until then, use the bank-transfer path below — it needs no aggregator at all.
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PRICE_NAIRA=7500                # legacy monthly price (kept as fallback)
PRICE_MONTHLY_NAIRA=7500        # monthly plan (NGN)
PRICE_YEARLY_NAIRA=50000        # yearly plan (saves ₦40,000 = 44% vs monthly)
PRICE_LIFETIME_NAIRA=100000     # lifetime one-time fee (NGN)
# USD mirror (exact FX parity) for non-Nigerian businesses. Paystack dashboard
# must have USD charges enabled or USD checkouts will fail.
PRICE_MONTHLY_USD=5
PRICE_YEARLY_USD=33
PRICE_LIFETIME_USD=65
TRIAL_DAYS=14
SUBSCRIPTION_DAYS=30
# Manual bank transfer (BVN-free path) — shown on the Billing page
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# Public base URL used for Paystack callback (set on Railway/Render, e.g. https://yourapp.up.railway.app)
PUBLIC_BASE_URL=
# ── Split deploy (Vercel frontend + Render backend) ──
# FRONTEND_URL: exact Vercel URL, set on RENDER (enables CORS + cross-site cookies).
# VITE_API_URL: exact Render URL, set in VERCEL dashboard (Vite bakes it at build!).
# Local dev: leave BOTH empty (same-origin mode, zero config).
FRONTEND_URL=
# VITE_API_URL is frontend-only: set it in Vercel, NOT in .env (Vite reads .env
# files too, but committing is avoided by keeping it dashboard-side).

# Daily digest
OWNER_WHATSAPP=whatsapp:+2348000000000
DIGEST_HOUR_UTC=17
