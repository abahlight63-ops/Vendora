<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window: the deep rail with the V mark centred, so the first
     paint is already the brand instead of a white flash. Flutter's own
     LogoReveal then continues from the same colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_bg" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
